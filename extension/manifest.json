{
  "manifest_version": 3,
  "name": "AI Build Coach - Provider Conversation Bridge",
  "version": "1.0.0",
  "description": "Explicit, user-controlled conversation capture from ChatGPT, Claude, and Gemini for AI Build Coach.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Build Coach Bridge"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
